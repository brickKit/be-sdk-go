.PHONY: test test-integration vet
vet:
	go vet ./...
test: vet  ## L1: unit tests, protocol vectors, the SDK's own merge-safety check
	go test -count=1 ./...
test-integration: vet  ## needs PostgreSQL and NATS (make up in the assembly project); fails without them
	go test -count=1 -tags integration ./...
